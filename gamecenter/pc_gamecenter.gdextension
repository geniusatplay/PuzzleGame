; Game Center sign-in (iPhone/iPad only). tools/export_ios.sh copies this into addons/pc_gamecenter/ for the iOS
; export only, so other platforms don't load an extension they have no library for.
[configuration]

entry_symbol = "pc_gamecenter_init"
compatibility_minimum = "4.5"

[libraries]

ios.debug = "res://addons/pc_gamecenter/bin/libpcgamecenter.ios.template_release.xcframework"
ios.release = "res://addons/pc_gamecenter/bin/libpcgamecenter.ios.template_release.xcframework"
